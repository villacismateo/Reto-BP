        { "id": "MOV-002", "fecha": "2026-10-16", "descripcion": "Pago servicio basico", "monto": -42.80, "tipo": "DEBITO" },
        { "id": "MOV-003", "fecha": "2026-10-17", "descripcion": "Transferencia recibida", "monto": 120.00, "tipo": "CREDITO" }
      ]
    }
  }
}
